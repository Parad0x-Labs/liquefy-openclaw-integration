{
  "name": "@parad0x_labs/openclaw-x402-pay",
  "version": "2.0.0",
  "description": "Self-custody x402 payments for OpenClaw agents on Solana. Your agent pays for x402-gated APIs, data, and other agents — you bring your own signer, so the skill never holds a private key — with a hard spend cap. Real-money mainnet is opt-in (set allowMainnet=true).",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "openclaw.plugin.json",
    "APPROVAL_INTEGRATION.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "x402",
    "solana",
    "payments",
    "agent-payments",
    "usdc",
    "micropayments",
    "non-custodial",
    "parad0x-labs"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": "1.x"
    },
    "build": {
      "openclawVersion": ">=1.0.0"
    }
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bs58": "4.0.1",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.6",
    "typebox": "1.1.39"
  },
  "overrides": {
    "underscore": "1.13.8"
  },
  "peerDependencies": {
    "openclaw": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bs58": "4.0.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --import ./test/register.mjs --test test/approval.test.mjs test/resolve.test.mjs",
    "audit": "npm audit --omit=dev --omit=peer --audit-level=high",
    "prepublishOnly": "npm audit --omit=dev --omit=peer --audit-level=high && tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Parad0x-Labs/openclaw-skills",
    "directory": "skills/x402-pay"
  }
}
